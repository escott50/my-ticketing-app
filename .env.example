# Copy this file to .env.local and fill in the values.
# .env.local is for your machine only and is not committed to git.

# A long random string (e.g. from a password generator, 32+ chars).
# Used to encrypt the "logged in" state. Keep it secret.
NEXTAUTH_SECRET=your-secret-at-least-32-chars

# Where your app runs: http://localhost:3001 for local dev, or your live URL when deployed.
NEXTAUTH_URL=http://localhost:3001

# From Google Cloud Console (see AUTH.md). Lets your app offer "Sign in with Google."
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase (Project Settings → API). Required for DB and NextAuth adapter.
# Use SUPABASE_SERVICE_ROLE_KEY or SUPABASE_SECRET_KEY (secret key from API Keys).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Dashboard → Developers → API keys). Secret key = sk_test_... or sk_live_...
# For organizer payouts, enable Connect (Dashboard → Connect → Get started) and use Express accounts.
STRIPE_SECRET_KEY=
